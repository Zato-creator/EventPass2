# ─── Servidor (solo Next.js en Vercel; NO llevan NEXT_PUBLIC_) ───
# URL base de los webhooks de producción de n8n (sin barra final)
N8N_WEBHOOK_BASE_URL=https://tu-instancia.app.n8n.cloud/webhook
# Valor del header X-EP-Key que validan todos los webhooks (Header Auth en n8n)
EP_API_KEY=cambia-esto-por-una-clave-larga-aleatoria

# ─── Públicas (se exponen al navegador; no poner secretos) ───
# URL del Chat Trigger de WF10 (modo embedded)
NEXT_PUBLIC_N8N_CHAT_URL=https://tu-instancia.app.n8n.cloud/webhook/xxxxxxxx-xxxx/chat
# Usuario del bot de Telegram, sin @
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=EventPassColegiosBot
# Nombre visible de la app
NEXT_PUBLIC_APP_NAME=EventPass Colegios

# true = el catálogo usa datos de ejemplo (src/lib/mocks). Solo para desarrollo local; en Vercel: false
NEXT_PUBLIC_USE_MOCKS=true
